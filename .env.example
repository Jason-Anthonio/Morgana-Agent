# Copy to .env and edit. .env is gitignored. Paths may start with ~.
# Every setting has a default; see morgana/config.py for the full list.

# Memory and state files shared with the Telegram wellness bot
WELLNESS_MEMORY_PATH=~/.hermes/scripts/wellness_memory/memory.json
WELLNESS_STATE_PATH=~/.hermes/scripts/wellness_state.json

# Microphone name substring or device index
MORGANA_INPUT_DEVICE="C270 HD WEBCAM"

# Local LLM server (scripts/start_local_llm.sh)
LLAMA_SERVER=~/llama.cpp/build/bin/llama-server
LOCAL_LLM_MODEL_PATH=~/models/qwen2.5-1.5b-instruct-q4_k_m.gguf
LOCAL_LLM_HOST=127.0.0.1
LOCAL_LLM_PORT=8080

# HTTP gateway. Keep it on localhost unless another machine must reach it:
# it has no authentication.
AGENT_API_HOST=127.0.0.1
AGENT_API_PORT=8643

# DEBUG adds wakeword score and HTTP request logs
LOG_LEVEL=INFO
